generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  DELIVERY
  VENDOR
}

enum OrderStatus {
  PENDING
  PAID
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
  COD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  COD
}

enum DeliveryAgentStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum SharePlatform {
  INSTAGRAM
  WHATSAPP
  TWITTER
}

enum CouponType {
  PERCENTAGE
  FLAT
  BOGO
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  passwordHash        String
  name                String
  phone               String?
  role                UserRole       @default(CUSTOMER)
  isActive            Boolean        @default(true)
  isEmailVerified     Boolean        @default(false)
  isTwoFactorEnabled  Boolean        @default(false)
  twoFactorSecret     String?
  failedLoginAttempts Int            @default(0)
  lockoutUntil        DateTime?      @db.Timestamptz(6)
  deletedAt           DateTime?      @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(6)

  addresses           Address[]
  orders              Order[]
  cart                Cart?
  wishlists           Wishlist[]
  reviews             Review[]
  refreshTokens       RefreshToken[]
  sessions            Session[]
  auditLogs           AuditLog[]
  deliveryAgent       DeliveryAgent?
  notifications       Notification[]

  @@index([email])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Address {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String
  street      String
  apartment   String?
  city        String
  state       String
  postalCode  String
  country     String    @default("IN")
  latitude    Float?
  longitude   Float?
  isDefault   Boolean   @default(false)
  deletedAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  @@index([userId])
  @@index([deletedAt])
  @@map("addresses")
}

model Category {
  id              String     @id @default(uuid())
  name            String
  slug            String     @unique
  description     String?
  image           String?
  parentId        String?
  parent          Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryHierarchy")
  metaTitle       String?
  metaDescription String?
  deletedAt       DateTime?  @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)

  products        Product[]

  @@index([slug])
  @@index([parentId])
  @@index([deletedAt])
  @@map("categories")
}

model Product {
  id              String           @id @default(uuid())
  title           String
  slug            String           @unique
  description     String
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  tags            String[]         @default([])
  images          String[]         @default([])
  featured        Boolean          @default(false)
  isPublished     Boolean          @default(true)
  metaTitle       String?
  metaDescription String?
  avgRating       Float            @default(0.0)
  reviewCount     Int              @default(0)
  deletedAt       DateTime?        @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)

  variants        ProductVariant[]
  reviews         Review[]
  wishlistItems   Wishlist[]
  shareLinks      ShareLink[]

  @@index([slug])
  @@index([categoryId])
  @@index([isPublished])
  @@index([featured])
  @@index([deletedAt])
  @@map("products")
}

model ProductVariant {
  id             String      @id @default(uuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String      @unique
  size           String?
  color          String?
  price          Float
  compareAtPrice Float?
  stock          Int         @default(0)
  weight         Float?
  deletedAt      DateTime?   @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)

  inventories    Inventory[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([productId])
  @@index([sku])
  @@index([deletedAt])
  @@map("product_variants")
}

model Inventory {
  id                 String         @id @default(uuid())
  variantId          String
  variant            ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse          String         @default("MAIN_HUB")
  quantity           Int            @default(0)
  reserved           Int            @default(0)
  lowStockThreshold  Int            @default(10)
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(6)

  @@unique([variantId, warehouse])
  @@index([variantId])
  @@map("inventories")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)

  items     CartItem[]

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @db.Timestamptz(6)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
  @@map("cart_items")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlists")
}

model Order {
  id                String       @id @default(uuid())
  orderNumber       String       @unique
  userId            String
  user              User         @relation(fields: [userId], references: [id])
  status            OrderStatus  @default(PENDING)
  currency          String       @default("INR")
  subtotal          Float
  discountAmount    Float        @default(0.0)
  taxAmount         Float        @default(0.0)
  shippingAmount    Float        @default(0.0)
  totalAmount       Float
  shippingAddressId String
  shippingAddress   Address      @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddressId  String?
  billingAddress    Address?     @relation("BillingAddress", fields: [billingAddressId], references: [id])
  couponId          String?
  coupon            Coupon?      @relation(fields: [couponId], references: [id])
  notes             String?
  cancellationReason String?
  deliveredAt       DateTime?    @db.Timestamptz(6)
  cancelledAt       DateTime?    @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(6)

  items             OrderItem[]
  payments          Payment[]
  shipments         Shipment[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String         @id @default(uuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  titleSnapshot   String
  skuSnapshot     String
  priceSnapshot   Float
  imageSnapshot   String
  quantity        Int
  subtotal        Float
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)

  reviews         Review[]

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id             String         @id @default(uuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway        PaymentGateway
  gatewayTxnId   String?        @unique
  idempotencyKey String?        @unique
  status         PaymentStatus  @default(PENDING)
  amount         Float
  currency       String         @default("INR")
  method         PaymentMethod?
  refunds        Json?          @default("[]")
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  @@index([orderId])
  @@index([gatewayTxnId])
  @@index([idempotencyKey])
  @@map("payments")
}

model Shipment {
  id             String         @id @default(uuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  agentId        String?
  agent          DeliveryAgent? @relation(fields: [agentId], references: [id])
  trackingNumber String         @unique
  courier        String         @default("ShopFlow Express")
  eta            DateTime?      @db.Timestamptz(6)
  liveLatitude   Float?
  liveLongitude  Float?
  statusHistory  Json           @default("[]")
  deliveryOtp    String?
  proofPhotoUrl  String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  @@index([orderId])
  @@index([agentId])
  @@index([trackingNumber])
  @@map("shipments")
}

model DeliveryAgent {
  id            String              @id @default(uuid())
  userId        String              @unique
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType   String              @default("Bike")
  vehicleNumber String
  status        DeliveryAgentStatus @default(AVAILABLE)
  currentOrders Int                 @default(0)
  rating        Float               @default(5.0)
  totalDeliveries Int               @default(0)
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(6)

  shipments     Shipment[]

  @@index([userId])
  @@index([status])
  @@map("delivery_agents")
}

model Coupon {
  id            String     @id @default(uuid())
  code          String     @unique
  description   String?
  discountType  CouponType @default(PERCENTAGE)
  discountValue Float
  minOrderValue Float      @default(0.0)
  maxDiscount   Float?
  usageLimit    Int?
  usedCount     Int        @default(0)
  expiresAt     DateTime?  @db.Timestamptz(6)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(6)

  orders        Order[]

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

model TaxRule {
  id          String   @id @default(uuid())
  name        String
  ratePercent Float
  country     String   @default("IN")
  state       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@map("tax_rules")
}

model Review {
  id          String     @id @default(uuid())
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])
  rating      Int
  title       String?
  comment     String
  isVerified  Boolean    @default(false)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)

  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // EMAIL, SMS, PUSH, IN_APP
  title     String
  message   String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entity     String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ShareLink {
  id             String        @id @default(uuid())
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  shortCode      String        @unique
  platform       SharePlatform @default(INSTAGRAM)
  utmSource      String        @default("instagram")
  utmMedium      String        @default("social")
  utmCampaign    String
  clicks         Int           @default(0)
  conversions    Int           @default(0)
  revenueEarned  Float         @default(0.0)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  @@index([shortCode])
  @@index([productId])
  @@map("share_links")
}
