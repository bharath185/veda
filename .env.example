# ========================================================
# ShopFlow Production & Development Environment Variables
# ========================================================

# Environment
NODE_ENV=development
PORT=4000

# Base URLs
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001
DELIVERY_BASE_URL=http://localhost:3002

# PostgreSQL & Prisma
DATABASE_URL=postgresql://shopflow_user:shopflow_secret@localhost:5432/shopflow_db?schema=public

# Redis Cache & BullMQ Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_ACCESS_SECRET=shopflow_super_secret_access_jwt_key_at_least_32_chars_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=shopflow_super_secret_refresh_jwt_key_at_least_32_chars_long
JWT_REFRESH_EXPIRATION=7d

# 2FA TOTP & Session Security
TOTP_APP_NAME=ShopFlow
SESSION_COOKIE_SECRET=shopflow_cookie_signing_secret_hash_minimum_32_chars

# Payment Gateways - Razorpay (India)
RAZORPAY_KEY_ID=rzp_test_shopflow_mock_key_id
RAZORPAY_KEY_SECRET=shopflow_rzp_mock_secret_key_12345
RAZORPAY_WEBHOOK_SECRET=shopflow_rzp_webhook_secret_key_12345

# Payment Gateways - Stripe (International)
STRIPE_PUBLIC_KEY=pk_test_shopflow_mock_stripe_key_12345
STRIPE_SECRET_KEY=sk_test_shopflow_mock_stripe_secret_key_12345
STRIPE_WEBHOOK_SECRET=whsec_shopflow_mock_stripe_webhook_secret_12345

# AWS S3 / CloudFront Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
AWS_S3_BUCKET=shopflow-assets-bucket
CDN_DOMAIN=https://cdn.shopflow.example.com

# Email / SMTP Notifications
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_smtp_user
SMTP_PASSWORD=mock_smtp_password
SMTP_FROM_EMAIL=no-reply@shopflow.example.com

# Monitoring & Error Tracking
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=true
